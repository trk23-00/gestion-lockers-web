generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id_rol     Int       @id @default(autoincrement())
  nivel      Int       @unique
  nombre_rol String    @unique @db.VarChar(100)
  usuarios   Usuario[]

  @@map("rol")
}

model Usuario {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(100)
  apellido             String                 @db.VarChar(100)
  ci                   String                 @unique @db.VarChar(20)
  correo               String                 @unique @db.VarChar(150)
  password             String                 @db.VarChar(255)
  telefono             String?                @db.VarChar(20)
  rolId                Int                    @map("rol")
  id_persona           BigInt                 @unique
  activo               Boolean                @default(true)
  notificacion_lectura notificacion_lectura[]
  persona              persona                @relation(fields: [id_persona], references: [id_persona], onDelete: NoAction, onUpdate: NoAction)
  rol                  Rol                    @relation(fields: [rolId], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)

  @@index([rolId], map: "idx_usuario_rol")
  @@map("usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cargo {
  id_cargo Int        @id @default(autoincrement()) @db.SmallInt
  nombre   String     @unique @db.VarChar(30)
  empleado empleado[]
}

model cliente {
  id_cliente    BigInt      @id
  observaciones String?
  persona       persona     @relation(fields: [id_cliente], references: [id_persona], onDelete: NoAction, onUpdate: NoAction)
  documento     documento[]
  paquete       paquete[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model configuracion {
  id              Int      @id @default(1)
  importe_inicial Decimal  @default(2) @db.Decimal(12, 2)
  recargo_semanal Decimal  @default(2) @db.Decimal(12, 2)
  dias_iniciales  Int      @default(7)
  actualizado_en  DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_documento {
  id_detalle            BigInt    @id @default(autoincrement())
  id_documento          BigInt
  tipo_documento        String    @db.VarChar(15)
  id_paquete            BigInt
  nombre_destinatario   String?   @db.VarChar(150)
  ci_destinatario       String?   @db.VarChar(30)
  telefono_destinatario String?   @db.VarChar(30)
  observaciones         String?
  anulado_en            DateTime? @db.Timestamptz(6)
  documento             documento @relation(fields: [id_documento, tipo_documento], references: [id_documento, tipo], onDelete: NoAction, onUpdate: NoAction)
  paquete               paquete   @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_documento, id_paquete])
  @@unique([id_paquete, tipo_documento], map: "detalle_documento_activo_key", where: raw("(anulado_en IS NULL)"))
  @@index([id_paquete, tipo_documento])
  @@index([id_documento], map: "idx_detalle_documento_documento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_traslado {
  id_detalle_traslado  BigInt    @id @default(autoincrement())
  id_traslado          BigInt
  id_paquete           BigInt
  recibido_en          DateTime? @db.Timestamptz(6)
  id_empleado_receptor BigInt?
  id_locker_destino    BigInt?
  observaciones        String?
  empleado             empleado? @relation(fields: [id_empleado_receptor], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  locker               locker?   @relation(fields: [id_locker_destino], references: [id_locker], onDelete: NoAction, onUpdate: NoAction)
  paquete              paquete   @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)
  traslado             traslado  @relation(fields: [id_traslado], references: [id_traslado], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_traslado, id_paquete])
  @@index([id_paquete], map: "idx_traslado_paquete")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model devolucion {
  id_devolucion BigInt      @id @default(autoincrement())
  id_paquete    BigInt      @unique
  monto         Decimal     @db.Decimal(12, 2)
  motivo        String
  fecha         DateTime    @default(now()) @db.Timestamptz(6)
  paquete       paquete     @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)
  movimiento    movimiento?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documento {
  id_documento      BigInt              @id @default(autoincrement())
  tipo              String              @db.VarChar(15)
  fecha             DateTime            @default(now()) @db.Timestamptz(6)
  id_sucursal       BigInt
  id_empleado       BigInt
  id_cliente        BigInt?
  observaciones     String?
  detalle_documento detalle_documento[]
  cliente           cliente?            @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  empleado          empleado            @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  sucursal          sucursal            @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_documento, tipo])
  @@index([id_sucursal, fecha], map: "idx_documento_fecha")
}

model empleado {
  auditorias       auditoria_operacion[]
  id_empleado      BigInt                @id
  id_cargo         Int                   @db.SmallInt
  id_sucursal      BigInt
  usuario          String                @unique @db.VarChar(80)
  password_hash    String?
  activo           Boolean               @default(true)
  detalle_traslado detalle_traslado[]
  documento        documento[]
  cargo            cargo                 @relation(fields: [id_cargo], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction)
  persona          persona               @relation(fields: [id_empleado], references: [id_persona], onDelete: NoAction, onUpdate: NoAction)
  sucursal         sucursal              @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)
  movimiento       movimiento[]
  notificacion     notificacion[]
  traslado         traslado[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model locker {
  id_locker        BigInt             @id @default(autoincrement())
  id_sucursal      BigInt
  codigo           String             @db.VarChar(30)
  tamanio          Int                @db.SmallInt
  habilitado       Boolean            @default(true)
  detalle_traslado detalle_traslado[]
  sucursal         sucursal           @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)
  paquete          paquete?

  @@unique([id_sucursal, codigo])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimiento {
  id_operacion       String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anulado_en         DateTime?        @db.Timestamptz(6)
  observaciones      String?
  id_movimiento      BigInt           @id @default(autoincrement())
  id_paquete         BigInt
  tipo               String           @db.VarChar(10)
  monto              Decimal          @db.Decimal(12, 2)
  fecha              DateTime         @default(now()) @db.Timestamptz(6)
  id_sucursal        BigInt
  id_empleado        BigInt
  pagador            String           @default("destinatario") @db.VarChar(15)
  medio              String           @default("efectivo") @db.VarChar(20)
  id_pago_pendiente  BigInt?          @unique
  id_pago_anticipado BigInt?          @unique
  id_devolucion      BigInt?          @unique
  devolucion         devolucion?      @relation(fields: [id_devolucion], references: [id_devolucion], onDelete: NoAction, onUpdate: NoAction)
  empleado           empleado         @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  pago_anticipado    pago_anticipado? @relation(fields: [id_pago_anticipado], references: [id_pago_anticipado], onDelete: NoAction, onUpdate: NoAction)
  pago_pendiente     pago_pendiente?  @relation(fields: [id_pago_pendiente], references: [id_pago_pendiente], onDelete: NoAction, onUpdate: NoAction)
  paquete            paquete          @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)
  sucursal           sucursal         @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_sucursal, fecha], map: "idx_movimiento_caja")
  @@index([id_paquete], map: "idx_movimiento_paquete")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notificacion {
  id_notificacion      BigInt                 @id @default(autoincrement())
  id_pago_pendiente    BigInt
  tipo                 String                 @db.VarChar(25)
  telefono             String                 @db.VarChar(30)
  contenido            String
  realizado_en         DateTime               @default(now()) @db.Timestamptz(6)
  id_empleado          BigInt?
  empleado             empleado?              @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  pago_pendiente       pago_pendiente         @relation(fields: [id_pago_pendiente], references: [id_pago_pendiente], onDelete: NoAction, onUpdate: NoAction)
  notificacion_lectura notificacion_lectura[]

  @@unique([id_pago_pendiente, tipo])
}

model notificacion_lectura {
  id_usuario      Int
  id_notificacion BigInt
  leido_en        DateTime     @default(now()) @db.Timestamptz(6)
  oculta          Boolean      @default(false)
  notificacion    notificacion @relation(fields: [id_notificacion], references: [id_notificacion], onDelete: Cascade, onUpdate: NoAction)
  usuario         Usuario      @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_usuario, id_notificacion])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pago_anticipado {
  id_pago_anticipado BigInt      @id @default(autoincrement())
  id_paquete         BigInt      @unique
  monto              Decimal     @db.Decimal(12, 2)
  fecha              DateTime    @default(now()) @db.Timestamptz(6)
  movimiento         movimiento?
  paquete            paquete     @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pago_pendiente {
  id_pago_pendiente BigInt         @id @default(autoincrement())
  id_paquete        BigInt
  concepto          String         @db.VarChar(15)
  numero_periodo    Int            @default(0)
  monto             Decimal        @db.Decimal(12, 2)
  generado_en       DateTime       @default(now()) @db.Timestamptz(6)
  vence_en          DateTime       @db.Timestamptz(6)
  movimiento        movimiento?
  notificacion      notificacion[]
  paquete           paquete        @relation(fields: [id_paquete], references: [id_paquete], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_paquete, concepto, numero_periodo])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paquete {
  id_paquete         BigInt              @id @default(autoincrement())
  codigo             String              @unique @db.VarChar(60)
  descripcion        String
  tamanio            Int                 @db.SmallInt
  peso_kg            Decimal?            @db.Decimal(10, 3)
  fecha_ingreso      DateTime            @default(now()) @db.Timestamptz(6)
  fecha_limite       DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @db.Timestamptz(6)
  fecha_entrega      DateTime?           @db.Timestamptz(6)
  estado             String              @default("recibido") @db.VarChar(20)
  id_sucursal_actual BigInt?
  id_locker          BigInt?             @unique
  modalidad_pago     String              @db.VarChar(15)
  importe_inicial    Decimal             @default(2.00) @db.Decimal(12, 2)
  recargo_semanal    Decimal             @default(2.00) @db.Decimal(12, 2)
  id_destinatario    BigInt?
  detalle_documento  detalle_documento[]
  detalle_traslado   detalle_traslado[]
  devolucion         devolucion?
  movimiento         movimiento[]
  pago_anticipado    pago_anticipado?
  pago_pendiente     pago_pendiente[]
  cliente            cliente?            @relation(fields: [id_destinatario], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  locker             locker?             @relation(fields: [id_locker], references: [id_locker], onDelete: NoAction, onUpdate: NoAction)
  sucursal           sucursal?           @relation(fields: [id_sucursal_actual], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_destinatario], map: "idx_paquete_destinatario")
  @@index([id_sucursal_actual], map: "idx_paquete_sucursal")
  @@index([fecha_limite], map: "idx_paquete_vencimiento", where: raw("((estado)::text <> 'entregado'::text)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model persona {
  id_persona BigInt    @id @default(autoincrement())
  nombre     String    @db.VarChar(150)
  ci         String?   @unique @db.VarChar(30)
  telefono   String?   @db.VarChar(30)
  correo     String?   @db.VarChar(150)
  activo     Boolean   @default(true)
  cliente    cliente?
  empleado   empleado?
  usuario    Usuario?
}

model resumen_diario {
  id_resumen_diario     BigInt   @id @default(autoincrement())
  id_sucursal           BigInt
  fecha                 DateTime @db.Date
  total_entradas        Decimal  @default(0) @db.Decimal(14, 2)
  total_salidas         Decimal  @default(0) @db.Decimal(14, 2)
  saldo                 Decimal? @default(dbgenerated("(total_entradas - total_salidas)")) @db.Decimal(14, 2)
  cantidad_cobros       Int      @default(0)
  cantidad_devoluciones Int      @default(0)
  actualizado_en        DateTime @default(now()) @db.Timestamptz(6)
  sucursal              sucursal @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_sucursal, fecha])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resumen_mensual {
  id_resumen_mensual    BigInt   @id @default(autoincrement())
  id_sucursal           BigInt
  periodo               DateTime @db.Date
  total_entradas        Decimal  @default(0) @db.Decimal(14, 2)
  total_salidas         Decimal  @default(0) @db.Decimal(14, 2)
  saldo                 Decimal? @default(dbgenerated("(total_entradas - total_salidas)")) @db.Decimal(14, 2)
  cantidad_cobros       Int      @default(0)
  cantidad_devoluciones Int      @default(0)
  actualizado_en        DateTime @default(now()) @db.Timestamptz(6)
  sucursal              sucursal @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_sucursal, periodo])
}

model sucursal {
  auditorias                                      auditoria_operacion[]
  id_sucursal                                     BigInt                @id @default(autoincrement())
  nombre                                          String                @unique @db.VarChar(100)
  direccion                                       String?
  activa                                          Boolean               @default(true)
  documento                                       documento[]
  empleado                                        empleado[]
  locker                                          locker[]
  movimiento                                      movimiento[]
  paquete                                         paquete[]
  resumen_diario                                  resumen_diario[]
  resumen_mensual                                 resumen_mensual[]
  traslado_traslado_id_sucursal_destinoTosucursal traslado[]            @relation("traslado_id_sucursal_destinoTosucursal")
  traslado_traslado_id_sucursal_origenTosucursal  traslado[]            @relation("traslado_id_sucursal_origenTosucursal")
}

model auditoria_operacion {
  id_auditoria BigInt   @id @default(autoincrement())
  entidad      String   @db.VarChar(15)
  id_registro  BigInt
  accion       String   @db.VarChar(15)
  motivo       String
  antes        Json     @db.JsonB
  despues      Json     @db.JsonB
  id_empleado  BigInt
  id_sucursal  BigInt
  fecha        DateTime @default(now()) @db.Timestamptz(6)
  empleado     empleado @relation(fields: [id_empleado], references: [id_empleado])
  sucursal     sucursal @relation(fields: [id_sucursal], references: [id_sucursal])

  @@index([entidad, id_registro])
  @@index([id_sucursal, fecha])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model traslado {
  id_traslado                                     BigInt             @id @default(autoincrement())
  id_sucursal_origen                              BigInt
  id_sucursal_destino                             BigInt
  id_empleado                                     BigInt
  estado                                          String             @default("preparado") @db.VarChar(15)
  creado_en                                       DateTime           @default(now()) @db.Timestamptz(6)
  fecha_salida                                    DateTime?          @db.Timestamptz(6)
  fecha_recepcion                                 DateTime?          @db.Timestamptz(6)
  observaciones                                   String?
  detalle_traslado                                detalle_traslado[]
  empleado                                        empleado           @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  sucursal_traslado_id_sucursal_destinoTosucursal sucursal           @relation("traslado_id_sucursal_destinoTosucursal", fields: [id_sucursal_destino], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)
  sucursal_traslado_id_sucursal_origenTosucursal  sucursal           @relation("traslado_id_sucursal_origenTosucursal", fields: [id_sucursal_origen], references: [id_sucursal], onDelete: NoAction, onUpdate: NoAction)
}
